@* Էջերի վերնագրի աջ մասը՝ ընթացիկ օգտատերը, "users" կոճակը (միայն ադմին) և ելքը *@
@using CPAWeb.UI.Client.Auth
@inject AuthService Auth
@inject NavigationManager Navigation

<div class="cpa-user-menu">
    <AuthorizeView Roles="@CpaClaims.AdminRole">
        <Authorized>
            @* "users" կոճակը տեսնում են միայն ադմինները *@
            <button type="button" class="btn btn-outline-primary btn-sm fw-semibold" @onclick="GoToUsers">
                <i class="bi bi-people me-1"></i> users
            </button>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView>
        <Authorized>
            <span class="cpa-user-name small fw-semibold" title="@context.User.Identity?.Name">
                <i class="bi bi-person-circle me-1"></i>@context.User.Identity?.Name
            </span>
            <button type="button" class="btn btn-outline-danger btn-sm fw-semibold" @onclick="LogoutAsync">
                <i class="bi bi-box-arrow-right me-1"></i> log out
            </button>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private void GoToUsers() => Navigation.NavigateTo("users");

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("login", replace: true);
    }
}
