@* Էջերի վերնագրի աջ մասը՝ ընթացիկ օգտատերը, "users" կոճակը (միայն ադմին) և ելքը *@
@using CPAWeb.UI.Client.Auth
@inject AuthService Auth
@inject NavigationManager Navigation

<div class="cpa-user-menu">
    <AuthorizeView Roles="@CpaClaims.AdminRole">
        <Authorized>
            @* "users" կոճակը տեսնում են միայն ադմինները *@
            <button type="button" class="btn btn-outline-primary btn-sm fw-semibold" @onclick="GoToUsers">
                <i class="bi bi-people me-1"></i> users
            </button>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView>
        <Authorized>
            @* Անվան վրա սեղմելիս ներքևում բացվում է ելքի կոճակը *@
            <div class="cpa-user-dropdown">
                <button type="button"
                        class="cpa-user-name-btn small fw-semibold @(_menuOpen ? "is-open" : null)"
                        title="@context.User.Identity?.Name"
                        aria-expanded="@(_menuOpen ? "true" : "false")"
                        @onclick="ToggleMenu">
                    <i class="bi bi-person-circle me-1"></i>
                    <span class="cpa-user-name">@context.User.Identity?.Name</span>
                    <i class="bi @(_menuOpen ? "bi-chevron-up" : "bi-chevron-down") ms-1"></i>
                </button>

                @if (_menuOpen)
                {
                    <div class="cpa-user-dropdown-menu">
                        <button type="button" class="btn btn-outline-danger btn-sm fw-semibold w-100" @onclick="LogoutAsync">
                            <i class="bi bi-box-arrow-right me-1"></i> log out
                        </button>
                    </div>
                }
            </div>
        </Authorized>
    </AuthorizeView>
</div>

@* Բացված ցանկից դուրս սեղմելը փակում է այն *@
@if (_menuOpen)
{
    <div class="cpa-user-dropdown-backdrop" @onclick="CloseMenu"></div>
}

@code {
    // Ելքի կոճակը բացվա՞ծ է
    private bool _menuOpen;

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    private void CloseMenu() => _menuOpen = false;

    private void GoToUsers()
    {
        _menuOpen = false;
        Navigation.NavigateTo("users");
    }

    private async Task LogoutAsync()
    {
        _menuOpen = false;
        await Auth.LogoutAsync();
        Navigation.NavigateTo("login", replace: true);
    }
}
