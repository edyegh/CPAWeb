@page "/sid-upload"
@page "/"
@using System.Net.Http.Headers
@using CPAWeb.Services.DTOs
@inject HttpClient Http

<div class="cpa-page-wrapper">
    <!-- Header Section -->
    <header class="cpa-header">
        <div class="brand-title">cpa</div>

        <div class="search-container">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text"
                       class="form-control border-start-0 shadow-none"
                       placeholder="search by name..."
                       @bind="searchQuery"
                       @onkeyup="HandleKeyUp" />
                <button class="btn btn-primary px-4 fw-semibold" @onclick="ExecuteSearch" disabled="@isSearching">
                    @if (isSearching)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    search
                </button>
            </div>
        </div>

        <div class="telecom-logo-container">
            <img src="assets/images/team-telecom-logo.png" alt="team telecom armenia" class="telecom-logo-img" />
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="cpa-content">
        @if (addResult != null)
        {
            <div class="alert alert-success border-0 shadow-sm d-flex justify-content-between align-items-start" role="alert">
                <div>
                    <div class="fw-bold mb-1"><i class="bi bi-check-circle me-1"></i> @addResult.Message</div>
                    <div class="small">
                        provider: <strong>@addResult.ProviderName</strong> &middot;
                        service name: <strong>@addResult.ServiceName</strong> &middot;
                        service id: <strong>@addResult.ServiceId</strong> &middot;
                        account id: <strong>@addResult.AccountId</strong>
                        @if (addResult.AccountCandidates.Count > 1)
                        {
                            <span> (other accounts: @string.Join(", ", addResult.AccountCandidates.Skip(1)))</span>
                        }
                    </div>
                </div>
                <button type="button" class="btn-close" @onclick="() => addResult = null"></button>
            </div>
        }

        @if (searchResults.Any())
        {
            <div class="card result-card shadow-sm">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold text-secondary">search result</h5>
                    <span class="badge bg-secondary">@searchResults.Count found</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">provider</th>
                                    <th scope="col">service name</th>
                                    <th scope="col">up</th>
                                    <th scope="col">service locator value</th>
                                    <th scope="col">service id</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in searchResults)
                                {
                                    <tr>
                                        <td class="fw-bold text-dark">@row.ProviderName</td>
                                        <td>@row.ServiceName</td>
                                        <td>@row.Up</td>
                                        <td class="fw-semibold">@row.ServiceLocatorValue</td>
                                        <td><span class="badge bg-light text-dark fs-6 border">@row.ServiceId</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else if (isSearching)
        {
            <div class="text-center my-5 py-5">
                <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
                <p class="text-muted mt-3 fs-5">searching...</p>
            </div>
        }
        else if (hasSearched && isNotFound)
        {
            <div class="alert alert-warning border-0 shadow-sm text-center my-4 py-4 fs-5" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i> no records found for "<strong>@executedQuery</strong>"
            </div>
        }
        else
        {
            <div class="empty-state text-center my-5 py-5">
                <h2 class="fw-bold text-secondary mb-3">find name location or register new name</h2>
                <p class="text-muted fs-5">use the search bar above or add a new record using the buttons below.</p>
            </div>
        }
    </main>

    <!-- Footer Actions -->
    <footer class="cpa-actions">
        <label for="excel-upload-input" class="btn btn-outline-success btn-custom m-0 me-3">
            <i class="bi bi-file-earmark-excel me-1"></i> upload file
        </label>
        <InputFile id="excel-upload-input" OnChange="OnInputFileChange" accept=".xlsx" style="display:none;" />

        <button class="btn btn-success btn-custom" @onclick="OpenAddNameModal">
            <i class="bi bi-plus-lg me-1"></i> add new name
        </button>

        <button class="btn btn-outline-warning btn-custom ms-auto" @onclick="OpenDuplicatesModal">
            <i class="bi bi-exclamation-triangle me-1"></i> already registered
            <span class="badge bg-warning text-dark ms-1">@duplicateNames.Count</span>
        </button>
    </footer>
</div>

<!-- 1. ADD NEW NAME MODAL -->
@if (isAddModalOpen)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark">register new name</h5>
                    <button type="button" class="btn-close" @onclick="CloseAddNameModal"></button>
                </div>
                <div class="modal-body pt-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary">name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-lg fs-6" @bind="newRecord.Name" placeholder="enter full name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary">number <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-lg fs-6" @bind="newRecord.Number" placeholder="6492 or 374088006492" />
                        <div class="form-text">service_id and account_id are resolved from this number.</div>
                    </div>
                    @if (!string.IsNullOrEmpty(addError))
                    {
                        <div class="alert alert-danger py-2 mt-3 mb-0">@addError</div>
                    }
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light px-4" @onclick="CloseAddNameModal">cancel</button>
                    <button type="button" class="btn btn-success px-4" @onclick="SaveNewRecord" disabled="@isSavingRecord">
                        @if (isSavingRecord)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        save record
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- 2. EXCEL PREVIEW MODAL -->
@if (isPreviewModalOpen)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">excel data preview & import</h5>
                    <button type="button" class="btn-close" @onclick="ClosePreviewModal"></button>
                </div>
                <div class="modal-body">
                    @if (isLoading)
                    {
                        <div class="text-center my-5">
                            <div class="spinner-border text-success" role="status"></div>
                            <p class="mt-2 text-muted">processing excel file...</p>
                        </div>
                    }
                    else if (previewSheets != null && previewSheets.Any())
                    {
                        @foreach (var sheet in previewSheets)
                        {
                            var isExpanded = expandedSheetNames.Contains(sheet.SheetName);
                            var isSaving = savingSheetNames.Contains(sheet.SheetName);

                            <div class="card mb-3 border">
                                <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                                    <h6 class="m-0 fw-bold text-dark">sheet: @sheet.SheetName</h6>
                                    <button class="btn btn-sm btn-outline-primary px-3" @onclick="() => ToggleSheetDetails(sheet.SheetName)">
                                        <i class="bi @(isExpanded ? "bi-chevron-up" : "bi-chevron-down") me-1"></i>
                                        @(isExpanded ? "hide details" : "view sheet data")
                                    </button>
                                </div>

                                @if (isExpanded)
                                {
                                    <div class="card-body">
                                        @if (sheet.MarkedRowFirstColumnValues != null && sheet.MarkedRowFirstColumnValues.Any())
                                        {
                                            <div class="table-responsive mb-3">
                                                <table class="table table-bordered table-hover align-middle mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th style="width: 10%;">#</th>
                                                            <th style="width: 90%;">name / value</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @for (int i = 0; i < sheet.MarkedRowFirstColumnValues.Count; i++)
                                                        {
                                                            <tr>
                                                                <td><span class="badge bg-secondary">@(i + 1)</span></td>
                                                                <td class="fw-semibold">@sheet.MarkedRowFirstColumnValues[i]</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <p class="text-muted mb-3">no highlighted records found for this sheet.</p>
                                        }

                                        <div class="d-flex justify-content-end">
                                            <button class="btn btn-success px-4"
                                                    disabled="@isSaving"
                                                    @onclick="() => ImportSheet(sheet)">
                                                @if (isSaving)
                                                {
                                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                                }
                                                save sheet data
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-warning m-0 border-0">no sheets found in the uploaded file.</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary px-4" @onclick="ClosePreviewModal">close</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- 3. MAIN NUMBER MODAL (staged names -> cpa_service_ident) -->
@if (isNumberModalOpen)
{
    <div class="modal-backdrop fade show" style="z-index: 1060;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1061;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark">enter main number</h5>
                    <button type="button" class="btn-close" @onclick="CloseNumberModal"></button>
                </div>
                <div class="modal-body pt-4">
                    <p class="text-muted mb-3">
                        <strong>@stagedCount</strong> name(s) from sheet
                        "<strong>@stagedSheetName</strong>" are ready to be registered.
                    </p>
                    @if (stagedDuplicates.Any())
                    {
                        <div class="alert alert-warning py-2 mb-3">
                            <div class="fw-semibold mb-1">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                @stagedDuplicates.Count name(s) are already registered:
                            </div>
                            <ul class="mb-0 ps-3 small" style="max-height: 140px; overflow-y: auto;">
                                @foreach (var duplicate in stagedDuplicates)
                                {
                                    <li>@duplicate</li>
                                }
                            </ul>
                        </div>
                    }

                    <label class="form-label fw-semibold text-secondary">number <span class="text-danger">*</span></label>
                    <input type="text" class="form-control form-control-lg fs-6" @bind="mainNumber" placeholder="6492 or 374088006492" />
                    <div class="form-text">service_id and account_id are resolved from this number.</div>

                    @if (!string.IsNullOrEmpty(commitError))
                    {
                        <div class="alert alert-danger py-2 mt-3 mb-0">@commitError</div>
                    }
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light px-4" @onclick="CloseNumberModal">cancel</button>
                    <button type="button" class="btn btn-success px-4" @onclick="CommitStagedNames" disabled="@isCommitting">
                        @if (isCommitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        register names
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- 4. ALREADY REGISTERED NAMES MODAL -->
@if (isDuplicatesModalOpen)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-exclamation-triangle text-warning me-1"></i> already registered names
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseDuplicatesModal"></button>
                </div>
                <div class="modal-body">
                    @if (isLoadingDuplicates)
                    {
                        <div class="text-center my-4">
                            <div class="spinner-border text-warning" role="status"></div>
                        </div>
                    }
                    else if (duplicateNames.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 50%;">name</th>
                                        <th style="width: 30%;">source</th>
                                        <th style="width: 20%;">detected</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var duplicate in duplicateNames)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@duplicate.Name</td>
                                            <td class="text-muted">@duplicate.Source</td>
                                            <td class="text-muted small">@duplicate.DetectedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success m-0 border-0">no already registered names so far.</div>
                    }
                </div>
                <div class="modal-footer">
                    <a class="btn btn-outline-primary px-4 @(duplicateNames.Any() ? "" : "disabled")"
                       href="@duplicatesFileUrl" target="_blank">
                        <i class="bi bi-download me-1"></i> download .txt
                    </a>
                    <button type="button" class="btn btn-outline-danger px-4"
                            disabled="@(!duplicateNames.Any())" @onclick="ClearDuplicates">
                        clear list
                    </button>
                    <button type="button" class="btn btn-secondary px-4" @onclick="CloseDuplicatesModal">close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // Search State
    private string searchQuery = string.Empty;
    private string executedQuery = string.Empty;
    private List<SIDSearchResultDto> searchResults = new();
    private bool isSearching = false;
    private bool isNotFound = false;
    private bool hasSearched = false;

    // Add New Name Modal State
    private bool isAddModalOpen = false;
    private bool isSavingRecord = false;
    private string addError = string.Empty;
    private CreateSIDDto newRecord = new();
    private AddNameResultDto? addResult;

    // Excel Import State
    private bool isPreviewModalOpen = false;
    private bool isLoading = false;
    private List<ExcelSheetPreviewDto> previewSheets = new();

    // Frontend Only UI States
    private HashSet<string> expandedSheetNames = new();
    private List<string> savingSheetNames = new();

    // Main Number Modal State (staged names -> cpa_service_ident)
    private bool isNumberModalOpen = false;
    private bool isCommitting = false;
    private string mainNumber = string.Empty;
    private string commitError = string.Empty;
    private string stagedSheetName = string.Empty;
    private int stagedCount = 0;
    private ExcelSheetPreviewDto? stagedSheet;
    private List<string> stagedDuplicates = new();

    // Already Registered (duplicate) Names State
    private bool isDuplicatesModalOpen = false;
    private bool isLoadingDuplicates = false;
    private List<DuplicateNameDto> duplicateNames = new();
    private string duplicatesFileUrl => $"{Http.BaseAddress}api/sid/duplicates/file";

    protected override async Task OnInitializedAsync()
    {
        await LoadDuplicates();
    }

    // --- Already Registered Names Logic ---
    private async Task LoadDuplicates()
    {
        isLoadingDuplicates = true;

        try
        {
            duplicateNames = await Http.GetFromJsonAsync<List<DuplicateNameDto>>("api/sid/duplicates") ?? new();
        }
        catch
        {
            duplicateNames = new();
        }
        finally
        {
            isLoadingDuplicates = false;
        }
    }

    private async Task OpenDuplicatesModal()
    {
        isDuplicatesModalOpen = true;
        await LoadDuplicates();
    }

    private void CloseDuplicatesModal()
    {
        isDuplicatesModalOpen = false;
    }

    private async Task ClearDuplicates()
    {
        var response = await Http.DeleteAsync("api/sid/duplicates");
        if (response.IsSuccessStatusCode)
        {
            duplicateNames = new();
        }
    }

    // --- Search Logic ---
    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ExecuteSearch();
        }
    }

    private async Task ExecuteSearch()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            searchResults = new();
            isNotFound = false;
            hasSearched = false;
            return;
        }

        isSearching = true;
        isNotFound = false;
        hasSearched = true;
        executedQuery = searchQuery;

        try
        {
            searchResults = await Http.GetFromJsonAsync<List<SIDSearchResultDto>>(
                $"api/sid/{Uri.EscapeDataString(searchQuery)}") ?? new();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            searchResults = new();
            isNotFound = true;
        }
        catch
        {
            searchResults = new();
        }
        finally
        {
            isSearching = false;
        }
    }

    // --- Add New Name Logic ---
    private void OpenAddNameModal()
    {
        newRecord = new CreateSIDDto();
        addError = string.Empty;
        isAddModalOpen = true;
    }

    private void CloseAddNameModal()
    {
        isAddModalOpen = false;
    }

    private async Task SaveNewRecord()
    {
        if (string.IsNullOrWhiteSpace(newRecord.Name) || string.IsNullOrWhiteSpace(newRecord.Number))
        {
            addError = "please fill in both name and number.";
            return;
        }

        isSavingRecord = true;
        addError = string.Empty;
        addResult = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/sid", newRecord);

            // Ե՛վ 200-ի, և՛ 400-ի դեպքում պատասխանը նույն DTO-ն է
            AddNameResultDto? result = null;
            try
            {
                result = await response.Content.ReadFromJsonAsync<AddNameResultDto>();
            }
            catch
            {
                // ignored — ստորև ցույց ենք տալիս ընդհանուր սխալը
            }

            if (response.IsSuccessStatusCode && result is { Success: true })
            {
                addResult = result;
                isAddModalOpen = false;
                searchQuery = newRecord.Name;

                // Թարմացնում ենք արդեն գրանցված անունների ցանկը
                await LoadDuplicates();
                await ExecuteSearch();
            }
            else
            {
                addError = string.IsNullOrWhiteSpace(result?.Message)
                    ? "չհաջողվեց ավելացնել տվյալները:"
                    : result!.Message;
            }
        }
        finally
        {
            isSavingRecord = false;
        }
    }

    // --- Excel Upload & Import Logic ---
    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        isLoading = true;
        isPreviewModalOpen = true;
        expandedSheetNames.Clear();
        savingSheetNames.Clear();

        using var content = new MultipartFormDataContent();
        var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 10485760));
        fileContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
        content.Add(fileContent, "file", file.Name);

        var response = await Http.PostAsync("api/sid/parse-preview", content);
        if (response.IsSuccessStatusCode)
        {
            previewSheets = await response.Content.ReadFromJsonAsync<List<ExcelSheetPreviewDto>>() ?? new();
        }

        isLoading = false;
    }

    private void ToggleSheetDetails(string sheetName)
    {
        if (expandedSheetNames.Contains(sheetName))
        {
            expandedSheetNames.Remove(sheetName);
        }
        else
        {
            expandedSheetNames.Add(sheetName);
        }
    }

    // Քայլ 1. Sheet-ի արժեքները դնում ենք ժամանակավոր աղյուսակում
    private async Task ImportSheet(ExcelSheetPreviewDto sheet)
    {
        savingSheetNames.Add(sheet.SheetName);

        var request = new ImportSheetRequestDto
        {
            SheetName = sheet.SheetName,
            Items = sheet.MarkedRowFirstColumnValues
        };

        var response = await Http.PostAsJsonAsync("api/sid/import-sheet", request);
        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<StageSheetResultDto>();
            if (result != null && result.StagedCount > 0)
            {
                // Քայլ 2. Հարցնում ենք հիմնական համարը
                stagedSheet = sheet;
                stagedSheetName = sheet.SheetName;
                stagedCount = result.StagedCount;
                stagedDuplicates = result.DuplicateNames ?? new();
                mainNumber = result.SuggestedNumber ?? string.Empty;
                commitError = string.Empty;
                isNumberModalOpen = true;

                // Թարմացնում ենք արդեն գրանցված անունների ցանկը
                await LoadDuplicates();
            }
        }

        savingSheetNames.Remove(sheet.SheetName);
    }

    // Քայլ 3. Ժամանակավոր աղյուսակից cpa_service_ident (նույն PL/SQL բլոկը, ինչ "add new name"-ը)
    private async Task CommitStagedNames()
    {
        if (string.IsNullOrWhiteSpace(mainNumber))
        {
            commitError = "please enter the main number.";
            return;
        }

        isCommitting = true;
        commitError = string.Empty;

        try
        {
            var response = await Http.PostAsJsonAsync("api/sid/commit-staged",
                new CommitStagedRequestDto { Number = mainNumber.Trim() });

            // Ե՛վ 200-ի, և՛ 400-ի դեպքում պատասխանը նույն DTO-ն է
            AddNameResultDto? result = null;
            try
            {
                result = await response.Content.ReadFromJsonAsync<AddNameResultDto>();
            }
            catch
            {
                // ignored — ստորև ցույց ենք տալիս ընդհանուր սխալը
            }

            if (response.IsSuccessStatusCode && result is { Success: true })
            {
                addResult = result;

                if (stagedSheet != null)
                {
                    expandedSheetNames.Remove(stagedSheet.SheetName);
                    previewSheets.Remove(stagedSheet);
                }

                CloseNumberModal();

                // Թարմացնում ենք արդեն գրանցված անունների ցանկը
                await LoadDuplicates();
            }
            else
            {
                commitError = string.IsNullOrWhiteSpace(result?.Message)
                    ? "չհաջողվեց գրանցել տվյալները:"
                    : result!.Message;
            }
        }
        finally
        {
            isCommitting = false;
        }
    }

    private void CloseNumberModal()
    {
        isNumberModalOpen = false;
        stagedSheet = null;
        stagedSheetName = string.Empty;
        stagedCount = 0;
        stagedDuplicates = new();
        mainNumber = string.Empty;
        commitError = string.Empty;
    }

    private void ClosePreviewModal()
    {
        isPreviewModalOpen = false;
        previewSheets.Clear();
        expandedSheetNames.Clear();
        savingSheetNames.Clear();
    }
}