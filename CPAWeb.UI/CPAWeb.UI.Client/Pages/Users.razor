@page "/users"
@using System.ComponentModel.DataAnnotations
@using CPAWeb.Services.DTOs
@using CPAWeb.UI.Client.Auth
@using CPAWeb.UI.Client.Layout
@* Էջը հասանելի է միայն ադմիններին — նույն սահմանափակումը կրկնվում է նաև API-ում *@
@attribute [Authorize(Roles = CpaClaims.AdminRole)]
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>CPA — users</PageTitle>

<div class="cpa-page-wrapper">
    <!-- Header Section -->
    <header class="cpa-header">
        <div class="brand-title">CPA</div>

        <div class="search-container">
            <h5 class="m-0 fw-bold text-secondary">users</h5>
        </div>

        <UserMenu />

        <div class="telecom-logo-container">
            <img src="assets/images/team-telecom-logo.png" alt="team telecom armenia" class="telecom-logo-img" />
        </div>
    </header>

    <main class="cpa-content">
        @if (!string.IsNullOrWhiteSpace(feedbackMessage))
        {
            <div class="alert @(feedbackIsError ? "alert-danger" : "alert-success") border-0 shadow-sm d-flex justify-content-between align-items-start" role="alert">
                <div class="fw-semibold">
                    <i class="bi @(feedbackIsError ? "bi-exclamation-triangle" : "bi-check-circle") me-1"></i> @feedbackMessage
                </div>
                <button type="button" class="btn-close" @onclick="() => feedbackMessage = null"></button>
            </div>
        }

        <div class="row g-4">
            <!-- Նոր օգտատեր՝ անուն, email, գաղտնաբառ -->
            <div class="col-lg-4">
                <div class="card result-card shadow-sm">
                    <div class="card-header bg-white border-bottom py-3">
                        <h5 class="m-0 fw-bold text-secondary">new user</h5>
                    </div>
                    <div class="card-body">
                        <EditForm Model="model" OnValidSubmit="HandleCreateAsync">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label class="form-label fw-semibold" for="user-name">name</label>
                                <InputText id="user-name" class="form-control" @bind-Value="model.Name" />
                                <ValidationMessage For="() => model.Name" class="small text-danger" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold" for="user-email">email</label>
                                <InputText id="user-email" class="form-control" placeholder="name@example.com" @bind-Value="model.Email" />
                                <ValidationMessage For="() => model.Email" class="small text-danger" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold" for="user-password">password</label>
                                <InputText id="user-password" type="password" class="form-control" autocomplete="new-password" @bind-Value="model.Password" />
                                <ValidationMessage For="() => model.Password" class="small text-danger" />
                            </div>

                            <div class="form-check mb-4">
                                <InputCheckbox id="user-is-admin" class="form-check-input" @bind-Value="model.IsAdmin" />
                                <label class="form-check-label" for="user-is-admin">
                                    admin (can see the "users" button)
                                </label>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 fw-semibold" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                }
                                add
                            </button>
                        </EditForm>
                    </div>
                </div>
            </div>

            <!-- Գրանցված օգտատերերի ցանկը -->
            <div class="col-lg-8">
                <div class="card result-card shadow-sm">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <h5 class="m-0 fw-bold text-secondary">registered users</h5>
                        <span class="badge bg-secondary">@users.Count</span>
                    </div>
                    <div class="card-body p-0">
                        @if (isLoading)
                        {
                            <div class="p-4 text-center text-muted">
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span> loading...
                            </div>
                        }
                        else if (users.Count == 0)
                        {
                            <div class="p-4 text-center text-muted">no users yet.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th scope="col">name</th>
                                            <th scope="col">email</th>
                                            <th scope="col">role</th>
                                            <th scope="col">added by</th>
                                            <th scope="col">date</th>
                                            <th scope="col" class="text-end">&nbsp;</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var user in users)
                                        {
                                            <tr>
                                                <td class="fw-bold text-dark">@user.Name</td>
                                                <td>@user.Email</td>
                                                <td>
                                                    <span class="badge @(user.Role == CpaClaims.AdminRole ? "bg-secondary" : "bg-light text-dark border")">
                                                        @user.Role
                                                    </span>
                                                </td>
                                                <td class="small text-muted">@(string.IsNullOrWhiteSpace(user.CreatedBy) ? "—" : user.CreatedBy)</td>
                                                <td class="small text-muted">@user.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                                <td class="text-end">
                                                    @if (IsCurrentUser(user))
                                                    {
                                                        @* Ինքն իրեն ջնջելը արգելված է նաև API-ում *@
                                                        <span class="badge bg-light text-dark border">you</span>
                                                    }
                                                    else
                                                    {
                                                        <button type="button"
                                                                class="btn btn-outline-danger btn-sm"
                                                                title="delete"
                                                                @onclick="() => AskDelete(user)">
                                                            <i class="bi bi-trash"></i> delete
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </main>

    <div class="cpa-actions">
        <button type="button" class="btn btn-light btn-custom" @onclick="GoBack">
            <i class="bi bi-arrow-left me-1"></i> back
        </button>
    </div>
</div>

<!-- ՋՆՋՄԱՆ ՀԱՍՏԱՏՈՒՄ -->
@if (userPendingDelete != null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark">delete user</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body pt-4">
                    <p class="mb-1">
                        are you sure you want to delete
                        <strong>@userPendingDelete.Name</strong> (@userPendingDelete.Email)?
                    </p>
                    <p class="text-muted small mb-0">this user will no longer be able to log in.</p>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light px-4" @onclick="CancelDelete">cancel</button>
                    <button type="button" class="btn btn-danger px-4" @onclick="ConfirmDeleteAsync" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        delete
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly CreateUserModel model = new();

    private List<UserDto> users = new();

    private bool isLoading = true;
    private bool isSubmitting;
    private bool isDeleting;

    private UserDto? userPendingDelete;

    // Ընթացիկ ադմինի email-ը — իր տողի դիմաց ջնջելու կոճակ չենք ցույց տալիս
    private string currentUserEmail = string.Empty;

    private string? feedbackMessage;
    private bool feedbackIsError;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask != null)
        {
            var state = await AuthenticationStateTask;
            currentUserEmail = state.User.FindFirst(CpaClaims.Email)?.Value ?? string.Empty;
        }

        await LoadUsersAsync();
    }

    private void GoBack() => Navigation.NavigateTo("/");

    private bool IsCurrentUser(UserDto user) =>
        string.Equals(user.Email, currentUserEmail, StringComparison.OrdinalIgnoreCase);

    private async Task LoadUsersAsync()
    {
        isLoading = true;

        try
        {
            users = await Auth.GetUsersAsync();
        }
        catch (HttpRequestException)
        {
            ShowFeedback("could not load the user list.", isError: true);
            users = new List<UserDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleCreateAsync()
    {
        isSubmitting = true;

        try
        {
            var result = await Auth.CreateUserAsync(new CreateUserDto
            {
                Name = model.Name,
                Email = model.Email,
                Password = model.Password,
                Role = model.IsAdmin ? CpaClaims.AdminRole : CpaClaims.UserRole
            });

            ShowFeedback(result.Message, isError: !result.Success);

            if (result.Success)
            {
                model.Reset();
                await LoadUsersAsync();
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void AskDelete(UserDto user)
    {
        feedbackMessage = null;
        userPendingDelete = user;
    }

    private void CancelDelete() => userPendingDelete = null;

    private async Task ConfirmDeleteAsync()
    {
        if (userPendingDelete == null)
            return;

        isDeleting = true;

        try
        {
            var result = await Auth.DeleteUserAsync(userPendingDelete.Id);

            ShowFeedback(result.Message, isError: !result.Success);
            userPendingDelete = null;

            if (result.Success)
            {
                await LoadUsersAsync();
            }
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void ShowFeedback(string message, bool isError)
    {
        feedbackMessage = message;
        feedbackIsError = isError;
    }

    private sealed class CreateUserModel
    {
        [Required(ErrorMessage = "name is required.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "email is required.")]
        [EmailAddress(ErrorMessage = "invalid email format.")]
        public string Email { get; set; } = string.Empty;

        // Նույն նվազագույնը, ինչ UserService.MinPasswordLength-ում
        [Required(ErrorMessage = "password is required.")]
        [MinLength(6, ErrorMessage = "password must be at least 6 characters.")]
        public string Password { get; set; } = string.Empty;

        public bool IsAdmin { get; set; }

        public void Reset()
        {
            Name = string.Empty;
            Email = string.Empty;
            Password = string.Empty;
            IsAdmin = false;
        }
    }
}
